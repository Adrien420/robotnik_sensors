<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="sensor_lidar_m10_p" params="id prefix prefix_laser parent *origin min_angle:=3.14159 max_angle:=-3.14159 include_inertial:=^|true">

    <joint name="${prefix_laser}_base_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}"/>
      <child link="${prefix_laser}_base_link"/>
    </joint>


    <link name="${prefix_laser}_base_link">
      <collision>
        <origin xyz="0 0 0.01" rpy="0 0 0"/>
        <geometry>
         <mesh filename="package://robotnik_sensors/meshes/lidar_m10_p.STL"/>
        </geometry>
      </collision>

      <visual>
        <origin xyz="0 0 0.01" rpy="0 0 0"/>
        <geometry>
            <mesh filename="package://robotnik_sensors/meshes/lidar_m10_p.STL" />
        </geometry>
      </visual>
      <xacro:if value="${include_inertial}">
        <inertial>
          <mass value="0.190" />
          <origin xyz="0.01 0 0.028" rpy="0 0 0"/> 
          <xacro:solid_cuboid_inertia m="0.190" w="0.09674" h="0.056" d="0.056" />
        </inertial>
      </xacro:if>
    </link>

    <joint name="${prefix_laser}_joint" type="fixed">
      <!-- <origin xyz="0 0 0.02305" rpy="0 0 0"/> -->
      <origin xyz="0.05 0.05 0.05" rpy="0 0 0"/>
      <parent link="${prefix_laser}_base_link"/>
      <child link="${prefix_laser}_link"/>
    </joint>

    <link name="${prefix_laser}_link">
    </link>

    <gazebo reference="${prefix_laser}_link">
      <sensor type="gpu_lidar" name="${prefix_laser}_sensor">
        <visualize>true</visualize>
        <update_rate>12</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>1636</samples>
              <resolution>1</resolution>
              <min_angle>${min_angle}</min_angle>
              <max_angle>${max_angle}</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.06</min>
            <max>10.0</max>
            <resolution>0.03</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <gz_frame_id>${prefix}${id}/${prefix_laser}_link</gz_frame_id>
        <topic>scan_${id}</topic>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
