<?xml version="1.0"?>
<robot name="all_sensors"
  xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:include filename="$(find robotnik_sensors)/urdf/utils/inertia.urdf.xacro" />
  <xacro:include filename="$(find robotnik_sensors)/urdf/utils/material.urdf.xacro" />
  
  <!-- This file unifies all sensors that can be used on simulation, defined as xacro:macros -->
  
  <!-- Lidar m10_p -->
  <xacro:include filename="$(find robotnik_sensors)/urdf/lidar_m10_p.urdf.xacro" />
  
</robot>
